# Copy this file to .env for local backend startup.

# Task backend server bind settings.
# Use 0.0.0.0 when the capture machine connects from another host.
ORBBEC_TASK_BACKEND_HOST=127.0.0.1
ORBBEC_TASK_BACKEND_PORT=8765

# Backend-owned setup registry, workflow database, and per-instance progress state.
ORBBEC_TASK_BACKEND_DATA_ROOT=./task_backend_state_fullflow

# Capture program uploads collection episodes; backend keeps NAS mapping for workflow resolution.
# Set ORBBEC_NAS_ENABLED=1 only for the legacy backend-side uploader.
ORBBEC_NAS_ENABLED=0
ORBBEC_NAS_ROOT=/mnt/nas
ORBBEC_NAS_URI_PREFIX=nas://ego
ORBBEC_NAS_MOUNTS_JSON={"nas://ego":"/mnt/nas"}

# Real Publisher Bridge (started/stopped inside task_backend/server.py).
# Enable this block on the capture/backend host after installing the fixed
# /usr/local/sbin/nas-uploader-status wrapper on the NAS.
ORBBEC_PUBLISHER_BRIDGE_ENABLED=0
ORBBEC_PUBLISHER_BRIDGE_MAX_INFLIGHT=4
ORBBEC_PUBLISHER_BRIDGE_POLL_SECONDS=20
ORBBEC_PUBLISHER_BRIDGE_LEASE_SECONDS=300
ORBBEC_PUBLISHER_BRIDGE_HEARTBEAT_SECONDS=60
# ORBBEC_PUBLISHER_BRIDGE_SSH_HOST=synology
# ORBBEC_MANO_PYTHON=/home/ubuntu/WorkSpace/zhenghao/opt_toolkits/.venv/bin/python
# ORBBEC_MANO_TOOLKIT_ROOT=/home/ubuntu/WorkSpace/zhenghao/opt_toolkits
# ORBBEC_MANO_MODEL_DIR=/home/ubuntu/WorkSpace/zhenghao/opt_toolkits/ckpt/mano
# ORBBEC_MANO_DEFAULT_SHAPE_PATH=/path/to/shared/shape.npy

# Upload success waits for an explicit dashboard/API push before auto_label.
ORBBEC_AUTO_LABEL_AFTER_UPLOAD=0

# Workflow worker defaults. With this block, workers start with:
# python3 tools/virtual_workflow/orbbec_virtual_workflow.py run-workers
ORBBEC_VIRTUAL_WORKFLOW_WORKERS=all
ORBBEC_WORKFLOW_NAS_ROOT=/mnt/nas
ORBBEC_WORKFLOW_NAS_URI_PREFIX=nas://ego
ORBBEC_VIRTUAL_WORKFLOW_QC_FAIL_RATE=0.5
ORBBEC_VIRTUAL_WORKFLOW_MAX_ITERATIONS=0
ORBBEC_VIRTUAL_WORKFLOW_STOP_AFTER_IDLE_ROUNDS=0
ORBBEC_VIRTUAL_WORKFLOW_IDLE_SLEEP=1.0
ORBBEC_VIRTUAL_WORKFLOW_IDLE_LOG_INTERVAL=30

# Optional: seed the setup page with a tasks file and a legacy state file.
# The setup page can still add other tasks files and instances.
# ORBBEC_TASK_BACKEND_TASK_FILE=./tasks.json
# ORBBEC_TASK_BACKEND_STATE_FILE=./task_backend_state_fullflow/progress_state.json
