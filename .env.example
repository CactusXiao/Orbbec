# Task backend server bind settings.
# Use 0.0.0.0 when the capture machine connects from another host.
ORBBEC_TASK_BACKEND_HOST=127.0.0.1
ORBBEC_TASK_BACKEND_PORT=8765

# Backend-owned setup registry and per-instance progress state.
ORBBEC_TASK_BACKEND_DATA_ROOT=./task_backend_state

# Optional: seed the setup page with a tasks file and a legacy state file.
# The setup page can still add other tasks files and instances.
# ORBBEC_TASK_BACKEND_TASK_FILE=./tasks.json
# ORBBEC_TASK_BACKEND_STATE_FILE=./task_backend_state/progress_state.json
