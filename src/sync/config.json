{
    "_comment": "avaliable mode: viewer,interaction,collection,calibration",
    "mode": "interaction",
    "viewer_fps": 30,
    "init_extrinsic_path": "extrinsic.json",
    "max_depth": 6.0,
    "different_color": false,
    "colorful_cloud_points": true,
    "filters": {
        "_filter_comment": "preset: Default/Hand/High Accuracy/High Density/Medium Density/Custom",
        "preset": "Default",
        "point_cloud_decimation_factor": 1,
        "decimation_filter_scale": 0,
        "noise_removal_filter_max_size": 0,
        "noise_removal_filter_min_diff": 0,
        "spatial_filter_alpha": 0,
        "spatial_filter_disp_diff": 0,
        "spatial_filter_magnitude": 0,
        "spatial_filter_radius": 0,
        "temporal_filter_diff_scale": 0,
        "temporal_filter_weight": 0,
        "hole_filling_filter_mode": 0,
        "desk_crop": true
    },
    "calibration": {
        "samplesPerPair": 20,
        "chessboard": {
            "rows": 8,
            "cols": 11,
            "squareSize": 0.03
        }
    },
    "extrinsicHealthCheck": {
        "_comment": "Multi-camera AprilTag extrinsic consistency check after READY and before Start. Python needs opencv-contrib-python.",
        "enabled": true,
        "pythonExecutable": "python3",
        "scriptPath": "extrinsic_health_check.py",
        "projectorPath": "extrinsic_health_projector",
        "projectionBackend": "orbbec_sdk",
        "tagFamily": "tag36h11",
        "tagSizeM": 0.096,
        "sampleCount": 5,
        "sampleIntervalMs": 200,
        "maxSnapshotAgeMs": 1000,
        "jpegQuality": 90,
        "keepDebugSnapshots": false,
        "blockOnInconclusive": true,
        "blockOnWarn": false,
        "requireAllCameras": true,
        "minSharedCamerasPerTag": 2,
        "minTagInlierObservations": 2,
        "minCheckedCameras": 3,
        "minTagsPerCamera": 2,
        "minPassingSnapshots": 3,
        "minFailingSnapshots": 2,
        "singleTagReprojLimitPx": 4.0,
        "fusionTransThreshM": 0.08,
        "fusionRotThreshDeg": 8.0,
        "warnTransThreshM": 0.015,
        "warnRotThreshDeg": 1.0,
        "warnReprojThreshPx": 5.0,
        "failTransThreshM": 0.025,
        "failRotThreshDeg": 2.0,
        "failReprojThreshPx": 8.0
    },
    "outputDir": "./collection_000",
    "durationSec": 5,
    "maxFrames": 1000,
    "collectFps": 30,
    "enableSync": true,
    "colorExposureMs": 0.8,
    "colorBrightness": -1,
    "colorCloudRgbFrameOffset": -1,
    "queueCapacity": 1024,
    "writerThreads": 0,
    "recordQueueCapacity": 1024,
    "coordQueueCapacity": 512,
    "writeQueueCapacity": 1024,
    "depthAlignWorkers": 0,
    "depthAlignQueueCapacity": 90,
    "cameraStreamTimeoutSec": 2.0,
    "voiceFeedback": {
        "_comment": "Voice prompts for collection mode. speakerDevice is used by the default Linux command as the ALSA aplay -D value, for example default, hw:1,0, or plughw:1,0. Optional command supports {text} and {device}, for example: espeak --stdout {text} | aplay -q -D {device}",
        "enabled": true,
        "speakerDevice": "default",
        "command": "",
        "messages": {
            "ready": "ready",
            "enter": "enter",
            "enter_failed": "enter failed",
            "start": "start",
            "start_failed": "start failed",
            "stop": "stop",
            "confirm": "confirm",
            "confirm_failed": "confirm failed",
            "reset": "reset",
            "reset_select": "reset select",
            "reset_confirm": "reset confirmed",
            "reset_cancel": "reset canceled",
            "delete_failed": "delete failed",
            "camera_fault": "camera error",
            "fault_exit": "exit",
            "fault_restart": "restart",
            "fault_restart_wait": "waiting",
            "fault_restart_failed": "restart failed",
            "menu": "menu",
            "config": "config"
        }
    },
    "save": {
        "rgbEncoding": "image",
        "depthEncoding": "png",
        "saveRaw": false,
        "colorExt": "jpg",
        "jpegQuality": 90,
        "pngCompression": 1,
        "h265Ext": "h265",
        "_h265_comment": "h265EncoderMode: software/hardware. h265Codec can be libx265, hevc_nvenc, nvenc_hevc, hevc_vaapi, hevc_qsv, or hevc_v4l2m2m. On this Ubuntu machine, hevc_nvenc is the recommended hardware encoder if NVIDIA driver is available.",
        "h265EncoderMode": "software",
        "h265Codec": "",
        "h265HwDevice": "/dev/dri/renderD128",
        "h265LogLevel": "info",
        "h265Preset": "medium",
        "h265Crf": 23,
        "h265Threads": 0,
        "h265QueueCapacity": 90,
        "depthFfv1QueueCapacity": 90,
        "h265ThreadsByCamera": {
            "00": 4,
            "01": 4,
            "02": 4
        }
    },
    "ego": {
        "_comment": "PICO ego streaming capture. Run adb reverse tcp:50051 tcp:50051 on Ubuntu, then launch the PICO app with EgoStreamingClientController. timeCalibrate estimates Pico-to-host clock offset before START. softAlignToOrbbecFirstFrame is the older Orbbec-first-frame alignment and is off by default. cameraParamsPath is the fixed calibrated ego parameter JSON copied into each episode.",
        "enabled": true,
        "host": "127.0.0.1",
        "port": 50051,
        "timeCalibrate": true,
        "timeCalibrateSampleCount": 20,
        "timeCalibrateTimeoutMs": 1000,
        "softAlignToOrbbecFirstFrame": false,
        "stopTimeoutMs": 60000,
        "maxBufferedFrames": 8192,
        "cameraId": "ego",
        "cameraParamsPath": "../../camera_info/ego_camera_params.json"
    },
    "fisheye": {
        "_comment": "Fish-eye cameras bind to a physical device by uniqueId. If the configured node cannot stream, startup will probe sibling video-index nodes on the same camera. camera1 -> left hand, camera2 -> right hand.",
        "enabled": true,
        "targetFps": 60,
        "maxBufferedSets": 4096,
        "cameras": [
            {
                "cameraId": "left_hand",
                "handRole": "left",
                "uniqueId": "v4l:/dev/v4l/by-id/usb-DCX-260417-KTY_usb_camera1_01.00.00-video-index0",
                "width": 1280,
                "height": 720,
                "fps": 60,
                "preferMjpeg": true
            },
            {
                "cameraId": "right_hand",
                "handRole": "right",
                "uniqueId": "v4l:/dev/v4l/by-id/usb-DCX-260417-KTY_usb_camera2_01.00.00-video-index0",
                "width": 1280,
                "height": 720,
                "fps": 60,
                "preferMjpeg": true
            }
        ]
    },
    
