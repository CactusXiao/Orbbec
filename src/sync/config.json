{
    "_comment": "avaliable mode: viewer,interaction,collection,calibration,label",
    "mode": "interaction",
    "viewer_fps": 30,
    "init_extrinsic_path": "extrinsic.json",
    "max_depth": 6.0,
    "different_color": false,
    "colorful_cloud_points": true,
    "filters": {
        "_filter_comment": "preset: Default/Hand/High Accuracy/High Density/Medium Density/Custom",
        "preset": "Default",
        "smooth_threshold": 0,
        "point_cloud_decimation_factor": 2,
        "decimation_filter_scale": 0,
        "noise_removal_filter_max_size": 80,
        "noise_removal_filter_min_diff": 256,
        "spatial_filter_alpha": 0,
        "spatial_filter_disp_diff": 0.5,
        "spatial_filter_magnitude": 0,
        "spatial_filter_radius": 0,
        "temporal_filter_diff_scale": 0,
        "temporal_filter_weight": 0,
        "hole_filling_filter_mode": 0,
        "desk_crop": false
    },
    "calibration": {
        "samplesPerPair": 20,
        "chessboard": {
            "rows": 8,
            "cols": 11,
            "squareSize": 0.03
        }
    },
    "extrinsicHealthCheck": {
        "_comment": "Multi-camera AprilTag extrinsic consistency check after READY and before Start. Python needs opencv-contrib-python.",
        "enabled": false,
        "pythonExecutable": "python3",
        "scriptPath": "extrinsic_health_check.py",
        "tagFamily": "tag36h11",
        "tagSizeM": 0.096,
        "rotationMethod": "pnp",
        "sampleCount": 5,
        "sampleIntervalMs": 200,
        "maxSnapshotAgeMs": 1000,
        "jpegQuality": 90,
        "keepDebugSnapshots": false,
        "blockOnInconclusive": false,
        "blockOnWarn": false,
        "requireAllCameras": true,
        "minSharedCamerasPerTag": 2,
        "minTagInlierObservations": 2,
        "minCheckedCameras": 2,
        "minTagsPerCamera": 1,
        "minPassingSnapshots": 1,
        "minFailingSnapshots": 2,
        "singleTagReprojLimitPx": 4.0,
        "fusionTransThreshM": 0.01,
        "fusionRotThreshDeg": 2.0,
        "warnTransThreshM": 0.004,
        "warnRotThreshDeg": 1.0,
        "warnReprojThreshPx": 4.0,
        "failTransThreshM": 0.008,
        "failRotThreshDeg": 2.0,
        "failReprojThreshPx": 8.0
    },
    "outputDir": "./collection_000",
    "durationSec": 0,
    "maxFrames": 1000,
    "collectFps": 30,
    "enableSync": true,
    "colorBrightness": -1,
    "colorCloudRgbFrameOffset": 0,
    "queueCapacity": 1024,
    "writerThreads": 0,
    "recordQueueCapacity": 1024,
    "coordQueueCapacity": 512,
    "writeQueueCapacity": 1024,
    "depthAlignWorkers": 0,
    "depthAlignQueueCapacity": 90,
    "cameraStreamTimeoutSec": 2.0,
    "taskBackend": {
        "_comment": "Backend-owned collection task/episode service. Start task_backend/server.py before entering collection.",
        "enabled": true,
        "baseUrl": "http://127.0.0.1:8765",
        "timeoutMs": 3000,
        "nas": {
            "_comment": "Capture-side NAS upload target. Backend .env keeps the same nas:// mapping for workflow resolution.",
            "enabled": true,
            "deleteLocalAfterUpload": true,
            "serverIp": "192.168.50.177",
            "shareName": "ego",
            "sharePath": "//192.168.50.177/ego",
            "mountPath": "/mnt/nas",
            "uriPrefix": "nas://ego"
        }
    },
    "frontends": {
        "_comment": "Programs launched by the main UI. These settings are written to an explicit launch config and passed with --config; Label/QC do not read env for these values.",
        "label": {
            "pythonExecutable": "python3",
            "operatorId": "",
            "logPath": "../../logs/orbbec_manual_label.log",
            "frameCacheDir": "../../tmp/label_rgb_frames",
            "ffmpegExecutable": "ffmpeg",
            "leaseSeconds": 600,
            "requestTimeoutSeconds": 10.0
        },
        "qc": {
            "pythonExecutable": "python3",
            "operatorId": "",
            "logPath": "../../logs/orbbec_qc_frontend.log",
            "sampleInterval": 10,
            "defaultLeaseMinutes": 10,
            "crashLeaseExtensionMinutes": 10,
            "tmpDir": "../../tmp/qc",
            "stateDir": "../../qc_state",
            "workerMachineId": "qc_machine_01",
            "rangeMergeGapFrames": 5,
            "requestTimeoutSeconds": 10.0,
            "playbackFps": 30.0,
            "meshRendererPython": "/home/ubuntu/WorkSpace/zhenghao/opt_toolkits/.venv/bin/python",
            "manoToolkitRoot": "/home/ubuntu/WorkSpace/zhenghao/opt_toolkits",
            "manoModelDir": "/home/ubuntu/WorkSpace/zhenghao/opt_toolkits/ckpt/mano",
            "meshRenderFactor": 1.0
        }
    },
    "voiceFeedback": {
        "_comment": "Ubuntu collection voice prompts. Chinese prompts prefer edge-tts zh-CN-XiaoxiaoNeural when installed (python3 -m pip install edge-tts; ffplay from ffmpeg), then fall back to spd-say, ekho, or espeak-ng. During recording, record_tick plays a short, low-volume tone at the configured interval.",
        "enabled": true,
        "speakerDevice": "default",
        "recordTickIntervalSeconds": 5.0,
        "recordTickFrequencyHz": 700,
        "recordTickDurationMs": 60,
        "recordTickVolume": 0.08,
        "command": "(tmp=$(mktemp /tmp/orbbec-voice.XXXXXX.mp3); rm -f \"$tmp\"; play_voice(){ if command -v ffplay >/dev/null 2>&1; then ffplay -nodisp -autoexit -loglevel quiet \"$1\"; elif command -v mpv >/dev/null 2>&1; then mpv --really-quiet --no-video \"$1\"; elif command -v mpg123 >/dev/null 2>&1; then mpg123 -q \"$1\"; else return 1; fi; }; if command -v edge-tts >/dev/null 2>&1 && edge-tts --voice zh-CN-XiaoxiaoNeural --text {text} --write-media \"$tmp\" >/dev/null 2>&1 && play_voice \"$tmp\"; then rm -f \"$tmp\"; exit 0; fi; rm -f \"$tmp\"; if command -v spd-say >/dev/null 2>&1; then spd-say -w -l zh-cn -- {text}; elif command -v ekho >/dev/null 2>&1; then ekho -v Mandarin {text}; elif command -v espeak-ng >/dev/null 2>&1; then espeak-ng -v cmn -s 155 {text}; elif command -v espeak >/dev/null 2>&1; then espeak -v zh -s 155 {text}; fi)",
        "messages": {
            "ready": "设备已就绪",
            "enter": "已进入采集",
            "enter_failed": "进入失败，请检查设备",
            "start": "开始采集",
            "record_tick": "",
            "start_failed": "启动失败，请检查设备",
            "stop": "已停止采集",
            "confirm": "采集已保存",
            "task_complete": "当前任务已全部完成，请更换任务",
            "confirm_failed": "保存失败，请稍后重试",
            "reset": "准备重置",
            "reset_select": "请选择要删除的采集",
            "reset_confirm": "已删除本次采集",
            "reset_cancel": "已取消删除",
            "delete_failed": "删除失败",
            "camera_fault": "相机异常，请检查连接",
            "fault_exit": "正在退出",
            "fault_restart": "相机已重启，请重新采集",
            "fault_restart_wait": "正在等待数据保存完成",
            "fault_restart_failed": "重启失败，请检查相机",
            "menu": "返回主菜单",
            "config": "返回配置",
            "tasks": "返回任务列表"
        }
